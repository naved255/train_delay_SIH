# =========================================================
# Railway ETA Intelligence System - Root .gitignore
# =========================================================

# -------------------------
# OS / Editor files
# -------------------------
.DS_Store
Thumbs.db
Desktop.ini

.vscode/
.idea/
*.swp
*.swo
*.tmp

# -------------------------
# Environment / Secrets
# -------------------------
.env
.env.*
!.env.example
!.env.sample

# -------------------------
# Node.js
# -------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -------------------------
# Frontend build files
# -------------------------
frontend/dist/
frontend/build/
frontend/.vite/

# -------------------------
# Python
# -------------------------
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/
myenv/
ml-service/venv/
ml-service/.venv/

# Python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# -------------------------
# ML / Jupyter
# -------------------------
*.pkl
*.pickle
*.joblib

*.joblib

# Keep the production LightGBM model
!ml-service/models/lgbm_railway_delay.joblib

# -------------------------
# ML experiment outputs
# -------------------------
runs/
logs/
wandb/
mlruns/
checkpoints/

# -------------------------
# Data
# -------------------------

# Ignore datasets
*.csv
*.xlsx
*.xls
*.parquet
*.feather

# Keep project dataset if you intentionally want it in Git
!backend/data/.gitkeep

# -------------------------
# Python generated files
# -------------------------
*.log
*.sqlite
*.sqlite3
*.db

# -------------------------
# Cache / temporary files
# -------------------------
.cache/
.tmp/
temp/
tmp/

# -------------------------
# Coverage / testing
# -------------------------
.coverage.*
coverage.xml
pytest-report.xml
test-results/


# -------------------------
# Archives
# -------------------------
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# -------------------------
# Local uploads
# -------------------------
uploads/
backend/uploads/
frontend/uploads/

# -------------------------
# Generated images / reports
# -------------------------
*.png
*.jpg
*.jpeg
*.webp
*.gif

# Keep documentation assets if needed
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.jpeg
!docs/**/*.webp

# -------------------------
# Local databases / storage
# -------------------------
data/
!backend/data/
!backend/data/.gitkeep

# -------------------------
# Deployment / local config
# -------------------------
.vercel/
.netlify/
.render/

# -------------------------
# Python packaging
# -------------------------
*.egg-info/
dist/
build/
.eggs/

# -------------------------
# Secrets / certificates
# -------------------------
*.pem
*.key
*.crt
*.p12
*.pfx

# -------------------------
# Misc
# -------------------------
.DS_Store
*.bak
*.backup
*.orig
